# LifeLens AI backend configuration
# Copy to .env and adjust if needed. All values have working defaults.

# SQLAlchemy database URL. Default is a local SQLite file in backend/.
LIFELENS_DATABASE_URL=sqlite:///./lifelens.db

# Comma-separated list of allowed CORS origins for local development.
LIFELENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum accepted CSV upload size in megabytes.
LIFELENS_MAX_UPLOAD_MB=10

# Directory used to store validated CSV uploads (relative to backend/).
LIFELENS_UPLOAD_DIR=storage/uploads
