# LifeLens AI frontend configuration — optional.
#
# Leave VITE_API_BASE_URL unset for local development: the Vite dev server proxies
# /api to the backend (see vite.config.ts), so same-origin requests just work.
#
# Set it only when serving the built frontend from somewhere other than the API
# origin, e.g. a static host pointing at a backend on another port.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Change the dev proxy target if the backend does not run on port 8000.
# VITE_PROXY_TARGET=http://127.0.0.1:8000
